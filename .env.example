# Salin file ini menjadi .env lalu isi nilainya.
# File .env berisi rahasia dan sudah masuk .gitignore.

# ===== Telegram =====
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# Kosongkan dulu. Jalankan bot, kirim /whoami, lalu isi dengan angka yang dibalas bot.
TELEGRAM_OWNER_CHAT_ID=
# Opsional. Isi hanya bila jaringanmu memblokir api.telegram.org, contoh: http://127.0.0.1:8080
TELEGRAM_PROXY=

# ===== LLM =====
# Format model mengikuti LiteLLM: <penyedia>/<nama-model>.
# Nama model sering berganti. Lihat model yang tersedia untuk key-mu dengan:
#     python -m scripts.daftar_model
# RPM dan RPD: isi sedikit DI BAWAH batas resmi paket gratis yang tertera di dashboard penyedia.

# Penyedia utama: Gemini (key dari Google AI Studio)
LLM_UTAMA_MODEL=gemini/gemini-3.5-flash-lite
LLM_UTAMA_RPM=8
LLM_UTAMA_RPD=200
GEMINI_API_KEY=

# Penyedia cadangan: Groq (key dari console.groq.com)
# RPM sengaja rendah: batas token per menit paket gratis Groq lebih cepat tercapai daripada batas request.
LLM_CADANGAN_MODEL=groq/openai/gpt-oss-120b
LLM_CADANGAN_RPM=5
LLM_CADANGAN_RPD=900
GROQ_API_KEY=

# Opsional: penyedia ketiga. Bisa model lain dengan key yang sama (contoh gemini/gemma-4-31b-it)
# atau model lokal lewat Ollama (contoh ollama/qwen2.5:7b). Kosongkan jika tidak dipakai.
LLM_LOKAL_MODEL=
LLM_LOKAL_RPM=10
LLM_LOKAL_RPD=500

# Pemakaian 80% kuota harian: peringatan. 90%: tugas tidak mendesak berhenti.
KUOTA_PERINGATAN=0.8
KUOTA_HENTI=0.9

# ===== Google =====
# File OAuth client (tipe Desktop app) yang diunduh dari Google Cloud Console
GOOGLE_CLIENT_SECRET=secrets/client_secret.json
# Kunci enkripsi token Google. Buat dengan: python -m scripts.buat_kunci
TOKEN_KEY=

# ===== Lokasi data =====
DB_PATH=data/agent.db
# Ganti ke data/profil.json setelah kamu mengisi profil asli (folder data/ tidak masuk repo)
PROFIL_PATH=data_dummy/profil.json
ZONA_WAKTU=Asia/Jakarta
